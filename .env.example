# Carely - Configuración de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno.

# Secreto de Django. ¡Usa uno único y seguro en producción!
DJANGO_SECRET_KEY=

# Hosts permitidos en producción (separados por coma).
DJANGO_ALLOWED_HOSTS=

# Base de datos MariaDB Cloud (backend MySQL).
DJANGO_DB_NAME=carely
DJANGO_DB_USER=your_user
DJANGO_DB_PASSWORD=your_password
DJANGO_DB_HOST=your_mariadb_host
DJANGO_DB_PORT=3306

# Supabase Storage S3-compatible.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=your_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
SUPABASE_STORAGE_BUCKET=carely-images

# SMTP de Gmail para confirmaciones de cuenta y recuperación de contraseña
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@carely.com

# Vigencia en segundos del enlace de reactivación que se envía al
# deshabilitar una cuenta. 604800 es una semana.
ACCOUNT_REACTIVATION_TIMEOUT=604800

# Verificación en dos pasos: longitud del código, vigencia en segundos e
# intentos permitidos antes de que el código quede bloqueado.
TWO_FACTOR_CODE_LENGTH=6
TWO_FACTOR_CODE_TTL=600
TWO_FACTOR_MAX_ATTEMPTS=5

# Datos públicos de la tienda (footer, página legal y correos).
# Si se dejan vacíos se usan los valores por defecto de config/settings/base.py.
CARELY_SITE_NAME=Carely
CARELY_SITE_DESCRIPTION=Tu tienda de cuidado personal de confianza
CARELY_EMAIL=carelywebsite@gmail.com
CARELY_PHONE=+57 323 227 3483
CARELY_PHONE_HREF=+573232273483
CARELY_ADDRESS=Medellín, Colombia
# Redes sociales: dejar vacío para ocultar el icono en el footer.
CARELY_SOCIAL_FACEBOOK=
CARELY_SOCIAL_INSTAGRAM=
CARELY_SOCIAL_WHATSAPP=
# Versión de los términos y condiciones. Al cambiarla, los usuarios que
# registraron con la versión anterior quedan marcados como desactualizados.
CARELY_TERMS_VERSION=2026-01-01
# Fecha que se muestra en la página legal; debe coincidir con la versión.
CARELY_TERMS_EFFECTIVE_DATE=1 de enero de 2026
