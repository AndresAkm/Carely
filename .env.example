# Carely - Configuración de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno.

# Secreto de Django. ¡Usa uno único y seguro en producción!
DJANGO_SECRET_KEY=

# Hosts permitidos en producción (separados por coma).
DJANGO_ALLOWED_HOSTS=

# Base de datos (producción usa PostgreSQL por defecto).
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=carely
DJANGO_DB_USER=carely
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# SMTP de Gmail para confirmaciones de cuenta y recuperación de contraseña
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Usa una contraseña de aplicación de Gmail, no tu contraseña personal.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@carely.com
