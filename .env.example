# Carely - Configuración de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Lo que no aparece aquí tiene un valor por defecto en config/settings/base.py.

# ── Seguridad ────────────────────────────────────────────────────────────────
# Sin esto Django genera una clave aleatoria en cada arranque, lo que cierra
# todas las sesiones al reiniciar el servidor.
DJANGO_SECRET_KEY=

# Hosts permitidos, separados por coma. Solo lo lee producción: en desarrollo
# ALLOWED_HOSTS es '*' fijo.
DJANGO_ALLOWED_HOSTS=

# ── Base de datos MariaDB Cloud (backend MySQL) ──────────────────────────────
# DJANGO_DB_NAME y DJANGO_DB_PORT ya traen default (carely y 3306).
DJANGO_DB_NAME=carely
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=

# ── Pasarela de pagos: Wompi ──────────────────────────────────────────────────
# Llaves y URL base deben pertenecer al mismo ambiente, o Wompi rechaza la
# operación. El ambiente se elige con WOMPI_API_URL:
#
#   sandbox      pub_test_ / prv_test_ / test_integrity_ / test_events_
#                https://sandbox.wompi.co/v1
#   producción   pub_prod_ / prv_prod_ / prod_integrity_ / prod_events_
#                https://production.wompi.co/v1
#
# Los cuatro valores salen del panel de Wompi (Developers). El de integridad
# firma el monto de la URL de checkout; el de eventos valida el checksum de los
# webhooks. Ninguno de los dos es la llave privada.
#
# Con PAYMENT_GATEWAY=simulado estas cuatro pueden quedar vacías y el flujo de
# pago se recorre entero sin salir a internet.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Pasarela activa: 'wompi' para cobrar de verdad, 'simulado' para desarrollo y
# pruebas sin red.
PAYMENT_GATEWAY=wompi

# ── Opcionales ────────────────────────────────────────────────────────────────
# Ninguna es obligatoria. Se listan para saber qué se puede cambiar sin tocar
# el código.

# Supabase Storage S3-compatible. Si falta cualquiera de las cuatro, se usa
# almacenamiento local y las imágenes van a media/.
# SUPABASE_URL=
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=

# Correo saliente. Sin esto los correos de confirmación y de recuperación
# fallan al enviarse (se registra el error, el alta del usuario no).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=no-reply@carely.com

# Vigencia en segundos del enlace de reactivación que se envía al deshabilitar
# una cuenta. 604800 es una semana.
# ACCOUNT_REACTIVATION_TIMEOUT=604800

# Verificación en dos pasos: longitud del código, vigencia en segundos e
# intentos antes de que el código quede bloqueado.
# TWO_FACTOR_CODE_LENGTH=6
# TWO_FACTOR_CODE_TTL=600
# TWO_FACTOR_MAX_ATTEMPTS=5

# Datos públicos de la tienda (footer, página legal y correos).
# CARELY_SITE_NAME=Carely
# CARELY_SITE_DESCRIPTION=Tu tienda de cuidado personal de confianza
# CARELY_EMAIL=carelywebsite@gmail.com
# CARELY_PHONE=+57 323 227 3483
# CARELY_PHONE_HREF=+573232273483
# CARELY_ADDRESS=Medellín, Colombia
# Redes sociales: vacío oculta el icono en el footer.
# CARELY_SOCIAL_FACEBOOK=
# CARELY_SOCIAL_INSTAGRAM=
# CARELY_SOCIAL_WHATSAPP=
# Al cambiar la versión de los términos, los usuarios que registraron con la
# anterior quedan marcados como desactualizados. La fecha debe coincidir.
# CARELY_TERMS_VERSION=2026-01-01
# CARELY_TERMS_EFFECTIVE_DATE=1 de enero de 2026