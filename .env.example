# Carely - Configuración de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno.

# Secreto de Django. ¡Usa uno único y seguro en producción!
DJANGO_SECRET_KEY=

# Hosts permitidos en producción (separados por coma).
DJANGO_ALLOWED_HOSTS=

# Base de datos MariaDB Cloud.
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=carely
DJANGO_DB_USER=your_user
DJANGO_DB_PASSWORD=your_password
DJANGO_DB_HOST=your_mariadb_host
DJANGO_DB_PORT=3306

# Supabase Storage S3-compatible.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=your_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=carely-images

# SMTP de Gmail para confirmaciones de cuenta y recuperación de contraseña
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@carely.com
